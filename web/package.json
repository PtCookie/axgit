{
    "name": "web",
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "gen:types": "openapi-typescript ../openapi.json -o src/lib/api/types.ts && prettier --write src/lib/api/types.ts",
        "gen:favicon": "node scripts/make-favicon.mjs",
        "lint": "eslint",
        "format": "prettier --write .",
        "check": "astro sync && tsc --noEmit && pnpm lint && prettier --check .",
        "test": "vitest",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@astrojs/react": "^6.0.6",
        "@base-ui/react": "^1.8.0",
        "@dicebear/core": "^10.7.0",
