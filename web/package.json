{
    "name": "web",
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "gen:types": "openapi-typescript ../openapi.json -o src/lib/api/types.ts && prettier --write src/lib/api/types.ts",
        "gen:favicon": "node scripts/make-favicon.mjs",
        "lint": "eslint",
        "format": "prettier --write .",
        "check": "astro sync && tsc --noEmit && pnpm lint && prettier --check .",
        "test": "vitest",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@astrojs/react": "^6.0.5",
        "@base-ui/react": "^1.7.0",
        "@dicebear/collection": "^9.4.2",
        "@dicebear/core": "^9.4.3",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@phosphor-icons/react": "^2.1.10",
        "astro": "^7.2.10",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^10.1.0",
        "recharts": "3.10.1",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "shadcn": "^4.20.1",
        "shiki": "^4.4.3",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.18.7",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitest/browser-playwright": "^4.1.11",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.9.1",
        "eslint-plugin-astro": "^3.1.0",
        "globals": "^17.12.0",
        "openapi-typescript": "^7.13.0",
        "playwright": "^1.62.1",
        "prettier": "3.9.6",
        "prettier-plugin-astro": "0.14.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "typescript-eslint": "^8.69.0",
        "vitest": "^4.1.11",
        "vitest-browser-react": "^2.2.0"
