---
import RepoLayout from "../../../layouts/RepoLayout.astro";
import CommitView, { CommitViewSkeleton } from "../../../components/repo/CommitView";
import { REPO_SHELL_PARAM } from "../../../lib/shell";

/**
 * One shell per route shape, not per repository — see `[repo]/index.astro`
 * (`api/src/shell.rs`, docs/DECISIONS.md #17). `sha` is a rest param so this
 * page's own segment count doesn't matter to Astro; passing `undefined`
 * builds exactly one file (`commit/index.html`) with no `sha` segment
 * appended. The real sha is read from `location.pathname` at runtime by
 * `CommitView` — the shell never needs a build-time value.
 */
export function getStaticPaths() {
  return [{ params: { repo: REPO_SHELL_PARAM, sha: undefined } }];
}
---

<RepoLayout active="commit" title="Commit — Axgit">
  <CommitView client:only="react">
    <div slot="fallback"><CommitViewSkeleton /></div>
  </CommitView>
</RepoLayout>
