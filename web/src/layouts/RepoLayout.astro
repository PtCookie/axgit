---
import Layout from "./Layout.astro";
import RepoNav from "../components/repo/RepoNav.astro";

type Active = "summary" | "refs" | "log" | "commit" | "tree" | "blob" | "blame";

interface Props {
  /** Which tab renders as current; also selects the document title shape. */
  active: Active;
  /** Static <title>, shown until the inline script substitutes the repo name. */
  title?: string;
}

const { active, title } = Astro.props;

const TITLE_SUFFIXES: Record<Active, string> = {
  summary: " — Axgit",
  refs: " refs — Axgit",
  log: " log — Axgit",
  commit: " commit — Axgit",
  tree: " tree — Axgit",
  blob: " blob — Axgit",
  blame: " blame — Axgit",
};
const titleSuffix = TITLE_SUFFIXES[active];

// Commit detail, blob view, and blame aren't their own tabs — they're
// drill-downs from the log and tree respectively — so the nav bar
// highlights the parent tab while showing any of them.
const NAV_ACTIVE: Record<Active, "summary" | "refs" | "log" | "tree"> = {
  summary: "summary",
  refs: "refs",
  log: "log",
  commit: "log",
  tree: "tree",
  blob: "tree",
  blame: "tree",
};
const navActive = NAV_ACTIVE[active];
---

<Layout title={title}>
  <RepoNav active={navActive} titleSuffix={titleSuffix} />
  {
    /*
      Everything on a repository page is static except the repository *name*:
      the shell is prerendered under a placeholder param (`lib/shell.ts`), so
      the name only exists in `location`. The fill-in logic itself lives in
      `Layout.astro`'s `data-repo-shell-init` script as
      `window.__axgit.fillRepoShell`, registered there against
      `astro:after-swap` so every client-side navigation (not just this
      page's own initial load) re-runs it. This one-line call handles the
      *first* load of a repository page, which happens before body content
      (and so before `Layout`'s head script could find `[data-repo-name]`
      itself even if it tried). `is:inline` keeps it a synchronous classic
      script that runs before first paint — a bundled `<script>` is deferred
      (`type="module"`) and would flash an empty heading and dead tab links.
    */
  }
  <script is:inline>
    window.__axgit.fillRepoShell();
  </script>
  <slot />
</Layout>
