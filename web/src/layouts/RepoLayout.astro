---
import Layout from "./Layout.astro";
import RepoNav from "../components/repo/RepoNav.astro";

type Active = "summary" | "refs" | "log" | "commit" | "tree" | "blob" | "blame";

interface Props {
  /** Which tab renders as current; also selects the document title shape. */
  active: Active;
  /** Static <title>, shown until the inline script substitutes the repo name. */
  title?: string;
}

const { active, title } = Astro.props;

const TITLE_SUFFIXES: Record<Active, string> = {
  summary: " — Axgit",
  refs: " refs — Axgit",
  log: " log — Axgit",
  commit: " commit — Axgit",
  tree: " tree — Axgit",
  blob: " blob — Axgit",
  blame: " blame — Axgit",
};
const titleSuffix = TITLE_SUFFIXES[active];

// Commit detail, blob view, and blame aren't their own tabs — they're
// drill-downs from the log and tree respectively — so the nav bar
// highlights the parent tab while showing any of them.
const NAV_ACTIVE: Record<Active, "summary" | "refs" | "log" | "tree"> = {
  summary: "summary",
  refs: "refs",
  log: "log",
  commit: "log",
  tree: "tree",
  blob: "tree",
  blame: "tree",
};
const navActive = NAV_ACTIVE[active];
---

<Layout title={title}>
  <RepoNav active={navActive} />
  {
    /*
      Everything on a repository page is static except the repository *name*:
      the shell is prerendered under a placeholder param (`lib/shell.ts`), so
      the name only exists in `location`. `is:inline` keeps this a
      synchronous classic script that runs before first paint — a bundled
      `<script>` is deferred (`type="module"`) and would flash an empty
      heading and dead tab links.
    */
  }
  <script is:inline data-title-suffix={titleSuffix}>
    {
      const suffix = document.currentScript.dataset.titleSuffix;
      // The raw segment is already correctly encoded for use in an href;
      // only the displayed name needs decoding.
      const segment = location.pathname.split("/")[1] ?? "";
      let name = segment;
      try {
        name = decodeURIComponent(segment);
      } catch {
        // A malformed escape means a hand-typed URL — show it verbatim
        // rather than aborting the script and leaving dead links.
      }

      document.title = name + suffix;
      document.querySelector("[data-repo-name]").textContent = name;
      for (const link of document.querySelectorAll("[data-repo-href]")) {
        const sub = link.dataset.repoHref;
        link.setAttribute("href", sub ? `/${segment}/${sub}` : `/${segment}`);
      }
    }
  </script>
  <slot />
</Layout>
