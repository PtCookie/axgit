---
interface Props {
  active: "summary" | "refs" | "log" | "tree";
  /** Appended after the repository name to build `document.title`, e.g.
   *  " log — Axgit". Carried on `data-title-suffix` rather than read from
   *  `document.currentScript`, since `window.__axgit.fillRepoShell`
   *  (`Layout.astro`) also runs from an `astro:after-swap` listener, where
   *  `document.currentScript` is `null`. */
  titleSuffix: string;
}

const { active, titleSuffix } = Astro.props;

/**
 * Static repository heading + tab bar. The repository name is unknown at
 * build time (this page is prerendered once under a placeholder param, see
 * `lib/shell.ts`), so `href`s carry a `data-repo-href` hook and the heading
 * carries `data-repo-name` — both are filled in by
 * `window.__axgit.fillRepoShell` (`Layout.astro`) before first paint and
 * again after every client-side navigation. `sub` is the path segment
 * appended to `/{repo}`; `""` is the summary page.
 */
const TABS = [
  { key: "summary", sub: "", label: "Summary" },
  { key: "tree", sub: "tree", label: "Tree" },
  { key: "log", sub: "log", label: "Log" },
  { key: "refs", sub: "refs", label: "Refs" },
] as const;
---

<div class="mb-6 space-y-3">
  <h1 class="font-heading text-2xl font-medium break-all" data-repo-name data-title-suffix={titleSuffix}></h1>
  <nav class="border-border flex gap-4 border-b">
    {
      TABS.map((tab) => (
        <a
          href="/"
          data-repo-href={tab.sub}
          aria-current={tab.key === active ? "page" : undefined}
          class:list={[
            "-mb-px border-b-2 px-1 pb-2 text-sm font-medium",
            tab.key === active
              ? "border-primary text-foreground"
              : "text-muted-foreground hover:text-foreground border-transparent",
          ]}
        >
          {tab.label}
        </a>
      ))
    }
  </nav>
</div>
