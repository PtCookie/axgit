{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "axgit-api",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--manifest-path",
        "api/Cargo.toml",
        "--",
        "--repo-root",
        "./fixtures/repos",
        "--static-dir",
        "./web/dist"
      ],
      "port": 8080
    },
    {
      "name": "axgit-embed",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--manifest-path",
        "api/Cargo.toml",
        "--features",
        "embed-web",
        "--",
        "--repo-root",
        "./fixtures/repos",
        "--listen",
        "127.0.0.1:8099"
      ],
      "port": 8099
    },
    {
      "name": "axgit-branding-demo",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--manifest-path",
        "api/Cargo.toml",
        "--",
        "--repo-root",
        "./fixtures/repos",
        "--static-dir",
        "./web/dist",
        "--logo",
        "./web/public/favicon.svg",
        "--favicon",
        "./web/public/favicon.svg",
        "--root-title",
        "PtCookie Git",
        "--listen",
        "127.0.0.1:8081"
      ],
      "port": 8081
    },
    {
      "name": "axgit-syntax-theme-demo",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--manifest-path",
        "api/Cargo.toml",
        "--",
        "--repo-root",
        "./fixtures/repos",
        "--static-dir",
        "./web/dist",
        "--syntax-theme-light",
        "solarized-light",
        "--syntax-theme-dark",
        "dracula",
        "--listen",
        "127.0.0.1:8082"
      ],
      "port": 8082
    }
  ]
}
